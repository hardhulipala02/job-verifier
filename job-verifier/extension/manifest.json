{
  "manifest_version": 3,
  "name": "Job Scam Checker",
  "version": "1.0.0",
  "description": "Scan recruiter messages (LinkedIn, etc.) on any page for scam red flags.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Job Scam Checker"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
