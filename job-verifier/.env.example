# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# Google Gemini (LLM behavioral analysis). Optional: the pipeline still runs
# with deterministic checks only when this is unset.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Neo4j (scam intelligence graph). Optional: persistence is skipped when unset.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# LLM retry tuning (exponential backoff)
LLM_MAX_RETRIES=4
LLM_BACKOFF_BASE_SECONDS=1.0

# Role verification: when enabled, the pipeline checks whether an advertised
# role actually exists by querying public ATS job boards (Greenhouse/Lever).
# Best-effort and graceful; off by default so tests/CI stay offline.
JOBVERIFIER_VERIFY_ROLE=0
JOBVERIFIER_ROLE_TIMEOUT=6.0

# URL reputation (VirusTotal / URLScan). Optional: URLs are always defanged; with
# a key, links are also checked and known-malicious ones flagged for quarantine.
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=
JOBVERIFIER_THREAT_TIMEOUT=8.0

# DNS infrastructure mapping: async A/NS resolution of sending domains, stored in
# Neo4j to link shared attacker infrastructure. Off by default (network).
JOBVERIFIER_RESOLVE_DNS=0
JOBVERIFIER_DNS_TIMEOUT=4.0

# Forward-to-address email bot (mailbot.py). Optional: only needed to run the
# "forward an email, get a report reply" flow. For Gmail, use an App Password
# (https://myaccount.google.com/apppasswords), not your normal password.
JOBVERIFIER_BOT_EMAIL=
JOBVERIFIER_BOT_PASSWORD=
JOBVERIFIER_IMAP_HOST=imap.gmail.com
JOBVERIFIER_IMAP_PORT=993
JOBVERIFIER_SMTP_HOST=smtp.gmail.com
JOBVERIFIER_SMTP_PORT=587
JOBVERIFIER_MAILBOX=INBOX
JOBVERIFIER_POLL_INTERVAL=30
